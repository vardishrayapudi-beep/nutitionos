# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.development
# Production requires at least 50 characters. Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Change the admin URL in production to something non-obvious (must end with "/")
DJANGO_ADMIN_URL=admin/

# --- PostgreSQL ---
DB_NAME=nutrition_os
DB_USER=nutrition_os
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# --- Reverse proxy (production) ---
# Number of trusted proxies/load balancers in front of Django (used to find the real client IP for
# rate limiting). Keep 0 for local development. Set it correctly when deploying, or every user
# behind your proxy will share one rate-limit bucket.
NUM_PROXIES=0

# --- Email (development prints emails to the console; set these for real delivery) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Nutrition OS <no-reply@yourdomain.com>
# Public URL of the web frontend (links in emails point here). Must be https in production.
FRONTEND_BASE_URL=http://localhost:5173
